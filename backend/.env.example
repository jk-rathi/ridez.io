# Set these in the process environment; this file is documentation, not auto-loaded.
APP_ENV=development
# Generate distinct random secrets; never commit real values.
JWT_SECRET=
USER_CODE_SECRET=
# Development only. Set to 0 to block new simulated quotes and bookings.
SIMULATOR_ENABLED=1
# 500-metre increments; default searches ten 30-second rounds up to 5 km.
MATCH_MAX_RADIUS_M=5000
# Omit to use the explicitly labeled local SQLite development database.
# DATABASE_URL=mssql+pyodbc://...?...driver=ODBC+Driver+18+for+SQL+Server
